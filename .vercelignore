# Private workstation settings and trust material are not deployment inputs.
.git/
.vercel/
**/.vercel/**
.env
.env.*
**/.env
**/.env.*
!.env.example
!backend/.env.example
*.local
**/*.local
**/*.pem
**/*.crt
**/*.cer
**/*.der
**/*.key
**/*.p12
**/*.pfx
backend/certs/
.npmrc
**/.npmrc
.yarnrc.yml
**/.yarnrc.yml

# Keep both services' sources, manifests, lockfiles, and public assets included.
node_modules/
**/node_modules/**
dist/
**/dist/**
.vite/
artifacts/
reports-source/
tmp/
backend/tmp/
backend/.cache/
backend/coverage/
**/*.log
