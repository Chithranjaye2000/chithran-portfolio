# Public browser configuration only. Never put DB or SMTP credentials here.
# Local development defaults to this address if the variable is absent.
VITE_API_BASE_URL=http://127.0.0.1:3001

# Optional Contact-only API origin. Leave commented to use the existing API base.
# VITE_CONTACT_API_BASE_URL=https://your-contact-backend.example.com

# Same-domain Vercel Services: leave BOTH API base variables unset or empty in Vercel.
# Contact then uses /api/contact on the current deployment. The localhost value above is local only.
# Projects and QA Evidence use static frontend data and do not request their APIs.
