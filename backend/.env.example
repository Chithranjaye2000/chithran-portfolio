# Local API settings; change FRONTEND_ORIGIN to the exact browser origin you use.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Replace these placeholders in backend/.env. Never use VITE_ for database settings.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_backend
DB_USER=your_local_database_user
DB_PASSWORD=replace_with_your_local_password

# Optional notification delivery. Messages are still saved when SMTP is unavailable.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=replace_with_your_smtp_password
SMTP_FROM=sender@example.com
SMTP_TO=recipient@example.com
