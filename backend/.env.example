# Local API settings; change FRONTEND_ORIGIN to the exact browser origin you use.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Vercel Services: set the production frontend origin in Vercel, enable system env access,
# and let Vercel supply VERCEL/VERCEL_URL/VERCEL_BRANCH_URL. Do not hardcode those values.
# Exact trusted deployment/branch origins are additionally allowed; no wildcard origins.

# Replace these placeholders in backend/.env. Never use VITE_ for database settings.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_backend
DB_USER=your_local_database_user
DB_PASSWORD=replace_with_your_local_password

# Local MySQL does not require SSL. Production requires SSL and a verified CA.
DB_SSL_ENABLED=false
# When SSL is enabled, set exactly ONE CA source (leave the other empty).
# DB_SSL_CA accepts a full PEM bundle with real newlines or literal \n sequences.
DB_SSL_CA=
# Absolute path or path relative to backend/, independent of the launch directory.
# Keep certificate files outside Git; backend/certs/ is ignored.
DB_SSL_CA_PATH=
# For Aiven: NODE_ENV=production, DB_SSL_ENABLED=true, exact service DNS host/port,
# service database/user/password, and the CA downloaded from your Aiven service.
# Set production secrets in the hosting platform; never use VITE_ variables.

# Contact has its own Aiven-only connection; Projects/QA still use DB_* above.
# Development reads the existing ignored backend/.env.aiven without changing it.
# Production requires these separate settings in the hosting platform:
# CONTACT_DB_HOST=your_aiven_service_dns_host
# CONTACT_DB_PORT=your_aiven_service_port
# CONTACT_DB_NAME=your_aiven_database
# CONTACT_DB_USER=your_aiven_contact_user
# CONTACT_DB_PASSWORD=replace_with_aiven_password
# CONTACT_DB_SSL_ENABLED=true
# CONTACT_DB_SSL_CA=complete_downloaded_pem_ca_bundle
# CONTACT_DB_SSL_CA_PATH=

# Gmail SMTP: use a Google App Password, NEVER a regular Gmail password.
# Local isolated notifications can be configured in ignored backend/.env.smtp.
# A saved message is retained if notification delivery is unavailable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender@gmail.com
SMTP_PASSWORD=replace_with_google_app_password
SMTP_FROM=your_sender@gmail.com
CONTACT_NOTIFICATION_EMAIL=your_recipient@gmail.com
# SMTP_TO is a legacy development fallback only; production uses the setting above.
